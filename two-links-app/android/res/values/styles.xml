<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#0D0F15</item>
        <item name="android:colorPrimaryDark">#0D0F15</item>
        <item name="android:colorAccent">#00E5FF</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0D0F15</item>
        <item name="android:navigationBarColor">#0D0F15</item>
